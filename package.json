{
  "name": "adb-shell",
  "private": true,
  "version": "1.4.0",
  "description": "Nativelike macOS/Windows/Linux app for everyday work with Android devices over adb.",
  "main": "dist/main/main.js",
  "author": "andrei-s96s",
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.renderer.json && node scripts/copy-assets.js",
    "test": "npm run build && node --test dist/test/*.test.js",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "fetch:win-adb": "node scripts/fetch-windows-adb.js",
    "fetch:aapt2:mac": "node scripts/fetch-aapt2.js mac",
    "fetch:aapt2:win": "node scripts/fetch-aapt2.js win",
    "fetch:aapt2:linux": "node scripts/fetch-aapt2.js linux",
    "fetch:scrcpy:mac": "node scripts/fetch-scrcpy.js mac",
    "fetch:scrcpy:win": "node scripts/fetch-scrcpy.js win",
    "fetch:scrcpy:linux": "node scripts/fetch-scrcpy.js linux",
    "dist:dir": "npm run build && electron-builder --dir --publish=never",
    "dist:win": "npm run build && npm run fetch:win-adb && npm run fetch:aapt2:win && npm run fetch:scrcpy:win && electron-builder --win --publish=never",
    "dist:mac": "npm run build && npm run fetch:aapt2:mac && npm run fetch:scrcpy:mac && electron-builder --mac --publish=never",
    "dist:linux": "npm run build && npm run fetch:aapt2:linux && npm run fetch:scrcpy:linux && electron-builder --linux --publish=never"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^22.10.0",
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.7.0"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "electron-winstaller@5.4.0": true
  },
  "build": {
    "appId": "local.adbshell",
    "productName": "ADB Shell",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "!**/*.map"
    ],
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools",
      "extraResources": [
        {
          "from": "vendor/mac",
          "to": ".",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "afterSign": "scripts/afterSign.js",
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "extraResources": [
        {
          "from": "vendor/win",
          "to": ".",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Development",
      "extraResources": [
        {
          "from": "vendor/linux",
          "to": ".",
          "filter": [
            "**/*"
          ]
        }
      ]
    }
  },
  "dependencies": {
    "adm-zip": "^0.5.16"
  }
}
